# SNSight configuration
#
# Copy to .env.local. Never commit real credentials: tokens are encrypted at rest in the database
# (spec 10.2) and the same care applies to these values.

# --- Core ------------------------------------------------------------------------------------
DATABASE_URL="postgresql://snsight:snsight@localhost:5432/snsight?schema=public"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- Provider selection (ADR-0007) ----------------------------------------------------------
# fixture | live. Defaults to fixture when unset: an unset variable must not cause live API calls.
# Live adapters are gated on Meta App Review and are not implemented yet.
SNSIGHT_PROVIDER="fixture"
# Fixed reference date for fixture generation. Keeps demo data stable across restarts.
SNSIGHT_FIXTURE_AS_OF="2026-07-31"
SNSIGHT_FIXTURE_SEED="demo"

# --- Meta: Instagram via Facebook Login (ADR-0002) ------------------------------------------
# Instagram requires the Facebook Login variant because Business Discovery (competitor
# monitoring) is unavailable on the Instagram Login flow. A linked Facebook Page is required.
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v21.0"
# Scope names are configuration, not constants, because App Review may grant a subset and the
# exact strings must be confirmed in the App Dashboard.
META_INSTAGRAM_SCOPES="instagram_basic,instagram_manage_insights,pages_show_list,pages_read_engagement"

# --- Meta: Threads (separate authorization and token lifecycle) -----------------------------
THREADS_APP_ID=""
THREADS_APP_SECRET=""
THREADS_SCOPES="threads_basic,threads_manage_insights"

# --- Token encryption (spec 10.2) -----------------------------------------------------------
# 32-byte key, base64. Rotatable: ciphertext rows record the key id that sealed them.
TOKEN_ENCRYPTION_KEY=""
TOKEN_ENCRYPTION_KEY_ID="k1"

# --- Object storage for raw API payloads and rendered reports (ADR-0005) --------------------
S3_ENDPOINT=""
S3_BUCKET="snsight-raw"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- AI provider (ADR-0006) -----------------------------------------------------------------
# Vendor is not yet chosen. The model id is pinned per run in ai_model_versions so reports can
# state what produced their text after the default changes.
AI_PROVIDER=""
AI_MODEL_ID=""
AI_API_KEY=""
