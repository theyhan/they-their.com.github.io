{
  "name": "snsight",
  "version": "0.1.0",
  "private": true,
  "description": "Instagram and Threads integrated insights platform",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "check": "npm run check:core && npm run check:dashboard && npm run check:design && npm run check:auth",
    "check:core": "tsx scripts/verify-core.ts",
    "check:dashboard": "tsx scripts/verify-dashboard.ts",
    "check:design": "tsx scripts/verify-design.ts",
    "check:auth": "tsx scripts/verify-auth.ts",
    "tokens:css": "tsx scripts/generate-tokens-css.ts",
    "preview": "tsx scripts/render-preview.ts",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1",
    "bullmq": "5.34.6",
    "ioredis": "5.4.2",
    "recharts": "2.15.0",
    "argon2": "0.41.1",
    "tailwind-merge": "2.6.0",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.6",
    "postcss": "8.5.1",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
